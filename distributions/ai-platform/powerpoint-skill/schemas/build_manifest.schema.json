{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/schemas/ow-build-manifest.schema.json",
  "title": "the firm BuildManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "plan_id",
    "deck_id",
    "task_instance_id",
    "publication_intent",
    "started_at",
    "completed_at",
    "provider",
    "inputs",
    "candidate",
    "slide_lineage",
    "element_dispositions",
    "requirement_dispositions",
    "findings",
    "qa",
    "artifacts",
    "status",
    "delivery"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "build_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "task_instance_id": {"type": "string", "minLength": 1},
    "publication_intent": {"enum": ["publish", "evaluate"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interface_version", "classification", "version", "engine", "engine_version"],
      "properties": {
        "id": {"type": "string"},
        "interface_version": {"const": "1.0.0"},
        "classification": {"enum": ["publishable_native", "evaluation_only"]},
        "version": {"type": "string"},
        "engine": {"type": "string"},
        "engine_version": {"type": "string"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deck_spec", "render_plan", "template", "template_manifest"],
      "properties": {
        "deck_spec": {"$ref": "#/$defs/artifact"},
        "render_plan": {"$ref": "#/$defs/artifact"},
        "template": {"$ref": "#/$defs/artifact"},
        "template_manifest": {"$ref": "#/$defs/artifact"}
      }
    },
    "candidate": {"$ref": "#/$defs/candidate"},
    "slide_lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_slide_id", "physical_slide_numbers", "actual_layouts"],
        "properties": {
          "source_slide_id": {"type": "string"},
          "physical_slide_numbers": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
          "actual_layouts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "element_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "element_id", "required", "status", "physical_slide_numbers", "shape_ids"],
        "properties": {
          "slide_id": {"type": "string"},
          "element_id": {"type": "string"},
          "required": {"type": "boolean"},
          "status": {"enum": ["emitted", "substituted", "dropped", "failed"]},
          "physical_slide_numbers": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "shape_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "details": {"type": "string"}
        }
      }
    },
    "requirement_dispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "required", "status", "slide_ids", "element_ids", "verification_evidence"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["verified_emitted", "missing", "contradicted", "not_required"]},
          "slide_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "element_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "verification_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_validation", "decision_critical_coverage", "provider_result", "package_integrity", "layout_geometry", "template_fidelity", "render_completeness", "visual_review", "report_parity"],
      "properties": {
        "contract_validation": {"$ref": "#/$defs/check"},
        "decision_critical_coverage": {"$ref": "#/$defs/check"},
        "provider_result": {"$ref": "#/$defs/check"},
        "package_integrity": {"$ref": "#/$defs/check"},
        "layout_geometry": {"$ref": "#/$defs/check"},
        "template_fidelity": {"$ref": "#/$defs/check"},
        "render_completeness": {"$ref": "#/$defs/check"},
        "visual_review": {"$ref": "#/$defs/check"},
        "report_parity": {"$ref": "#/$defs/check"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_result", "structural_report"],
      "properties": {
        "provider_result": {"$ref": "#/$defs/artifact"},
        "structural_report": {"$ref": "#/$defs/artifact"},
        "finalizer_receipt": {"$ref": "#/$defs/artifact"},
        "companion_report": {"$ref": "#/$defs/artifact"},
        "render_directory": {"type": "string"},
        "visual_review": {"$ref": "#/$defs/artifact"}
      }
    },
    "final": {"$ref": "#/$defs/artifact"},
    "status": {"enum": ["built", "awaiting_visual_review", "validated", "blocked", "failed"]},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {"enum": ["eligible", "ineligible"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "slide_count": {"type": "integer", "minimum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "slide_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "slide_count": {"type": "integer", "minimum": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["passed", "warning", "failed", "skipped"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "source", "severity", "blocking", "status", "message"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "severity": {"enum": ["hard", "advisory"]},
        "blocking": {"type": "boolean"},
        "status": {"enum": ["open", "resolved", "accepted_user_override"]},
        "slide_id": {"type": "string"},
        "element_id": {"type": "string"},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"properties": {"classification": {"const": "evaluation_only"}}}}},
      "then": {"properties": {"delivery": {"properties": {"status": {"const": "ineligible"}}}}}
    },
    {
      "if": {"properties": {"delivery": {"properties": {"status": {"const": "eligible"}}}}},
      "then": {
        "required": ["final"],
        "properties": {
          "publication_intent": {"const": "publish"},
          "status": {"const": "validated"},
          "provider": {"properties": {"classification": {"const": "publishable_native"}}},
          "qa": {
            "properties": {
              "contract_validation": {"properties": {"status": {"const": "passed"}}},
              "decision_critical_coverage": {"properties": {"status": {"const": "passed"}}},
              "provider_result": {"properties": {"status": {"const": "passed"}}},
              "package_integrity": {"properties": {"status": {"const": "passed"}}},
              "layout_geometry": {"properties": {"status": {"const": "passed"}}},
              "template_fidelity": {"properties": {"status": {"const": "passed"}}},
              "render_completeness": {"properties": {"status": {"const": "passed"}}},
              "visual_review": {"properties": {"status": {"const": "passed"}}},
              "report_parity": {"properties": {"status": {"const": "passed"}}}
            }
          },
          "artifacts": {"required": ["provider_result", "structural_report", "finalizer_receipt", "companion_report", "render_directory", "visual_review"]},
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["blocking", "status"],
                "properties": {"blocking": {"const": true}, "status": {"const": "open"}}
              }
            }
          },
          "element_dispositions": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["required", "status"],
                "properties": {"required": {"const": true}, "status": {"enum": ["dropped", "failed"]}}
              }
            }
          },
          "requirement_dispositions": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["required", "status"],
                "properties": {
                  "required": {"const": true},
                  "status": {"enum": ["missing", "contradicted"]}
                }
              }
            }
          }
        }
      }
    }
  ]
}
